{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lorz0619-cell/Umbra-phone-agent/benchmarks/schema/umbra-benchmark.schema.json",
  "title": "Umbra device benchmark suite",
  "type": "object",
  "required": ["schema_version", "name", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "defaults": { "$ref": "#/$defs/runOptions" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "runOptions": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["MAIN_SCREEN", "VIRTUAL_DISPLAY"] },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 200 },
        "timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 1800 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "terminal_phases": {
          "type": "array",
          "items": { "enum": ["COMPLETE", "TAKEOVER", "FAILED"] }
        },
        "required_actions": { "type": "array", "items": { "type": "string" } },
        "required_system_tools": { "type": "array", "items": { "type": "string" } },
        "forbidden_actions": { "type": "array", "items": { "type": "string" } },
        "package_regex": { "type": "string" },
        "max_steps": { "type": "integer", "minimum": 0 },
        "max_reflections": { "type": "integer", "minimum": 0 },
        "max_failed_verifications": { "type": "integer", "minimum": 0 },
        "manual": { "type": "boolean" },
        "manual_prompt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "instruction"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "enabled": { "type": "boolean" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "mode": { "enum": ["MAIN_SCREEN", "VIRTUAL_DISPLAY"] },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 200 },
        "timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 1800 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 50 },
        "required_packages": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "oracle": { "$ref": "#/$defs/oracle" }
      },
      "additionalProperties": false
    }
  }
}
