<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Shell-only bridge for local device evaluation. Never included in release builds. -->
        <receiver
            android:name=".benchmark.BenchmarkCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.bluewhale.agent.debug.RUN_BENCHMARK" />
                <action android:name="com.bluewhale.agent.debug.STOP_BENCHMARK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
